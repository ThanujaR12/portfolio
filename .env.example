# Where curated content is read/written: "fs" (local content/ folder) or "github" (Contents API)
CONTENT_SOURCE=fs
GITHUB_USER=ThanujaR12
# Fine-grained token: public repo read + contents read/write on the portfolio repo (optional locally)
GITHUB_TOKEN=
GITHUB_CONTENT_REPO=ThanujaR12/portfolio

# Admin sign-in (Auth.js GitHub provider)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=ThanujaR12
# Optional: your numeric GitHub user id, so a renamed/re-registered login can't sign in
ADMIN_GITHUB_ID=
# Development only: shows "Dev: owner / other user" sign-in buttons (ignored in production builds)
ADMIN_DEV_LOGIN=

# AI assistant. With a free Google AI Studio key it uses Gemini; without one (or with
# AI_PROVIDER=mock) it falls back to offline, rule-based answers from the same content.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Questions per visitor per hour (default 20 in production)
CHAT_LIMIT_PER_HOUR=

# Rate limiting (optional locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact email (optional locally; messages are logged instead)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
